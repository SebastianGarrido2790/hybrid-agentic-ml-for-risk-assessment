# LLM API Keys (Replace with your actual keys)
GOOGLE_API_KEY="YOUR_GOOGLE_GEMINI_API_KEY"
HUGGINGFACEHUB_API_TOKEN="YOUR_HUGGINGFACE_API_TOKEN"

# LLM Configuration (Uncomment to override defaults)
# GEMINI_POWER_MODEL=gemini-2.0-flash
# GEMINI_LITE_MODEL=gemini-2.0-flash-lite
# HF_MODEL=Qwen/Qwen2.5-7B-Instruct

# Project Configuration
PROJECT_NAME="ACRAS"
LOG_LEVEL=INFO
ENV=local # Options: local, staging, production

# MLflow Configuration
MLFLOW_TRACKING_URI=http://127.0.0.1:5000

# Evaluation Configuration (LLM-as-a-Judge)
# The Judge harness currently requires GOOGLE_API_KEY as it uses Gemini Flash.
# Set to 1 to enable MLflow logging during 'make evals'
LOG_EVALS_TO_MLFLOW=0

# OpenTelemetry Tracing (Elite Infrastructure)
# Endpoint for the OTLP HTTP collector (e.g., Jaeger)
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
# Set to 1 to enable ConsoleSpanExporter for local debugging
DEBUG_TELEMETRY=0

# Note: In CI/Tests, exporters are automatically suppressed via TESTING=1
